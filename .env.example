# Generated automatically by ./setup.sh if .env does not already exist.
# Copy to .env and customize before running ./setup.sh to use custom settings.
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

SPANNER_PROJECT_ID=your-gcp-project-id
SPANNER_LOCATION=europe-west1
SPANNER_INSTANCE_ID=transport-graph-instance
SPANNER_DATABASE_ID=transport-graph
SPANNER_GRAPH_IDS=TransportGraph

QUERY_DATA_API_VERSION=v1alpha
QUERY_DATA_LOCATION=us-central1
QUERY_DATA_EXECUTE_QUERY=true
QUERY_DATA_INCLUDE_RAW=false
NL2GQL_BACKEND=querydata
GEMINI_MODEL=gemini-3.8-flash
SHOW_SAMPLE_PROMPTS=true
# SAMPLE_PROMPTS_FILE=sample_prompts.json
# TOPOLOGY_FILE=topology.json

GOOGLE_CLOUD_SPANNER_MULTIPLEXED_SESSIONS=false
SPANNER_DISABLE_BUILTIN_METRICS=true
